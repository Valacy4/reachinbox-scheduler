# --- Database ---
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox_scheduler?schema=public"

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Ethereal SMTP (get these from `npm run test:ethereal` or https://ethereal.email) ---
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user@ethereal.email
ETHEREAL_PASS=your-ethereal-pass

# --- Worker / rate limiting (all configurable, per assignment requirements) ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Google OAuth (backend verifies the ID token the frontend sends) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com